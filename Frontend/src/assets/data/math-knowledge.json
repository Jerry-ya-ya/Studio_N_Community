{
  "version": 2,
  "defaultCenter": "gradient",
  "nodes": [
    {
      "id": "field-axiom",
      "title": "Field Axiom（體公設）",
      "category": "axiom",
      "definition": "體公設規定實數上的加法與乘法如何運作：兩種運算滿足封閉性、交換律、結合律，具有單位元素與反元素，並由分配律彼此連結。",
      "latex": "(\\mathbb{R},+,\\cdot)\\text{ is a field}",
      "simpleExplanation": "實數的四則運算之所以能穩定使用，是因為它們共同遵守一套基本規則。",
      "symbolDefinitions": [
        { "symbol": "R", "latex": "\\mathbb{R}", "description": "實數所形成的集合。" },
        { "symbol": "+, ·", "latex": "+,\\cdot", "description": "實數上的加法與乘法運算。" }
      ]
    },
    {
      "id": "field-closure",
      "title": "封閉性",
      "category": "property",
      "definition": "任意兩個實數相加或相乘，結果仍然是實數。",
      "latex": "\\forall a,b\\in\\mathbb{R},\\quad a+b\\in\\mathbb{R},\\quad ab\\in\\mathbb{R}",
      "simpleExplanation": "用實數做加法或乘法，不會跑出實數系統之外。",
      "symbolDefinitions": [
        { "symbol": "a, b", "latex": "a,b\\in\\mathbb{R}", "description": "任意兩個實數。" },
        { "symbol": "∈", "latex": "\\in", "description": "表示某個元素屬於一個集合。" }
      ]
    },
    {
      "id": "field-commutativity",
      "title": "交換律",
      "category": "property",
      "definition": "加法與乘法交換兩個運算元的順序，結果不變。",
      "latex": "a+b=b+a,\\qquad ab=ba",
      "simpleExplanation": "相加或相乘時，前後順序不影響答案。",
      "symbolDefinitions": [
        { "symbol": "a, b", "latex": "a,b", "description": "任意實數。" }
      ]
    },
    {
      "id": "field-associativity",
      "title": "結合律",
      "category": "property",
      "definition": "三個實數進行連續加法或乘法時，先計算哪一組不影響結果。",
      "latex": "(a+b)+c=a+(b+c),\\qquad (ab)c=a(bc)",
      "simpleExplanation": "只做加法或只做乘法時，括號換位置不會改變答案。",
      "symbolDefinitions": [
        { "symbol": "a, b, c", "latex": "a,b,c", "description": "任意三個實數。" }
      ]
    },
    {
      "id": "field-identities",
      "title": "單位元素",
      "category": "property",
      "definition": "實數中存在加法單位元素 0 與乘法單位元素 1，而且 0 與 1 不相等。",
      "latex": "a+0=a,\\qquad a\\cdot1=a,\\qquad 0\\ne1",
      "simpleExplanation": "加上 0 或乘上 1，都會保留原來的數。",
      "symbolDefinitions": [
        { "symbol": "0", "latex": "0", "description": "加法單位元素。" },
        { "symbol": "1", "latex": "1", "description": "乘法單位元素。" }
      ]
    },
    {
      "id": "field-inverses",
      "title": "反元素",
      "category": "property",
      "definition": "每個實數都有加法反元素；每個非零實數另有乘法反元素。",
      "latex": "a+(-a)=0,\\qquad a\\ne0\\Rightarrow a\\cdot a^{-1}=1",
      "simpleExplanation": "每個數都能用相反數抵消；非零的數也能用倒數抵消乘法。",
      "symbolDefinitions": [
        { "symbol": "−a", "latex": "-a", "description": "a 的加法反元素。" },
        { "symbol": "a⁻¹", "latex": "a^{-1}", "description": "非零實數 a 的乘法反元素。" }
      ]
    },
    {
      "id": "field-distributivity",
      "title": "分配律",
      "category": "property",
      "definition": "乘法對加法具有分配性，因而把兩種運算一致地連結起來。",
      "latex": "a(b+c)=ab+ac",
      "simpleExplanation": "括號外的乘數，可以分別乘進括號內的每一項。",
      "symbolDefinitions": [
        { "symbol": "a, b, c", "latex": "a,b,c", "description": "任意三個實數。" }
      ]
    },
    {
      "id": "order-axiom",
      "title": "Order Axiom（序公設）",
      "category": "axiom",
      "definition": "序公設賦予實數一致的大小關係：任意兩數可以比較，順序具有遞移性，且加法與正數乘法會保持不等式方向。",
      "latex": "(\\mathbb{R},<)\\text{ is an ordered field}",
      "simpleExplanation": "實數不只可以運算，也能按大小排成一條與運算相容的數線。",
      "symbolDefinitions": [
        { "symbol": "<", "latex": "<", "description": "實數之間的嚴格小於關係。" },
        { "symbol": "ordered field", "latex": "(\\mathbb{R},+,\\cdot,<)", "description": "運算與大小順序彼此相容的體。" }
      ]
    },
    {
      "id": "order-trichotomy",
      "title": "三一律",
      "category": "property",
      "definition": "任意兩個實數恰好滿足小於、等於或大於三種關係中的一種。",
      "latex": "\\text{exactly one of }a<b,\\quad a=b,\\quad a>b",
      "simpleExplanation": "比較兩個實數時，只有小於、等於、大於其中一種情況成立。",
      "symbolDefinitions": [
        { "symbol": "a, b", "latex": "a,b\\in\\mathbb{R}", "description": "被比較的兩個實數。" }
      ]
    },
    {
      "id": "order-transitivity",
      "title": "遞移性",
      "category": "property",
      "definition": "若第一個實數小於第二個，且第二個小於第三個，則第一個小於第三個。",
      "latex": "a<b\\land b<c\\Rightarrow a<c",
      "simpleExplanation": "如果 a 排在 b 前面、b 又排在 c 前面，那麼 a 一定排在 c 前面。",
      "symbolDefinitions": [
        { "symbol": "⇒", "latex": "\\Rightarrow", "description": "表示前面的條件可推出後面的結論。" }
      ]
    },
    {
      "id": "order-addition-compatibility",
      "title": "加法保序性",
      "category": "property",
      "definition": "不等式兩邊同加一個實數，大小關係保持不變。",
      "latex": "a<b\\Rightarrow a+c<b+c",
      "simpleExplanation": "比較的兩邊一起平移相同距離，前後次序不會改變。",
      "symbolDefinitions": [
        { "symbol": "c", "latex": "c\\in\\mathbb{R}", "description": "不等式兩邊共同加上的實數。" }
      ]
    },
    {
      "id": "order-multiplication-compatibility",
      "title": "正乘保序性",
      "category": "property",
      "definition": "不等式兩邊同乘一個正實數，大小關係保持不變。",
      "latex": "a<b\\land 0<c\\Rightarrow ac<bc",
      "simpleExplanation": "比較的兩邊同時用正數放大或縮小，前後次序不會改變。",
      "symbolDefinitions": [
        { "symbol": "c > 0", "latex": "c>0", "description": "兩邊共同乘上的正實數。" }
      ]
    },
    {
      "id": "real-function",
      "title": "實函數",
      "category": "foundation",
      "definition": "實函數把定義域中的每個實數輸入，唯一對應到一個實數輸出，是微積分中描述變化關係的基本物件。",
      "latex": "f: D \\subseteq \\mathbb{R} \\to \\mathbb{R}, \\qquad x \\mapsto f(x)",
      "simpleExplanation": "把一個數字送進規則，得到唯一的一個數字。",
      "symbolDefinitions": [
        { "symbol": "D", "latex": "D", "description": "函數的定義域。" },
        { "symbol": "f(x)", "latex": "f(x)", "description": "輸入 x 對應的函數值。" }
      ]
    },
    {
      "id": "limit",
      "title": "極限",
      "category": "analysis",
      "definition": "當 x 任意接近 a 時，若 f(x) 能任意接近同一個數 L，則稱 f 在 a 的極限為 L。極限描述的是靠近某點時的趨勢，不要求函數在該點有定義。",
      "latex": "\\lim_{x \\to a} f(x)=L",
      "simpleExplanation": "不一定要碰到目標點，只看越靠近時，函數值正在靠近哪裡。",
      "symbolDefinitions": [
        { "symbol": "a", "latex": "a", "description": "輸入所接近的目標點。" },
        { "symbol": "L", "latex": "L", "description": "函數值所接近的極限值。" }
      ]
    },
    {
      "id": "continuity",
      "title": "連續性",
      "category": "analysis",
      "definition": "函數 f 在 a 連續，表示 f(a) 有定義、a 點的極限存在，而且極限值等於函數值。",
      "latex": "\\lim_{x \\to a} f(x)=f(a)",
      "simpleExplanation": "在這個點附近畫函數圖形時，不需要把筆抬起來。",
      "symbolDefinitions": [
        { "symbol": "f(a)", "latex": "f(a)", "description": "函數在 a 點的實際值。" },
        { "symbol": "lim", "latex": "\\lim_{x \\to a}", "description": "從 a 附近觀察函數的趨勢。" }
      ]
    },
    {
      "id": "derivative",
      "title": "導數",
      "category": "calculus",
      "definition": "導數是函數在某點的瞬時變化率，由差商在增量趨近零時的極限定義；幾何上等於該點切線的斜率。",
      "latex": "f'(x)=\\lim_{h \\to 0}\\frac{f(x+h)-f(x)}{h}",
      "simpleExplanation": "把觀察時間縮到非常短，量出函數此刻變化得有多快。",
      "symbolDefinitions": [
        { "symbol": "f'(x)", "latex": "f'(x)", "description": "f 在 x 點的瞬時變化率。" },
        { "symbol": "h", "latex": "h", "description": "趨近於零的輸入增量。" }
      ],
      "visualization": {
        "type": "derivative-tangent",
        "caption": "拖曳滑桿觀察 y=x²/2 上不同位置的切線；切線斜率就是該點的導數。"
      }
    },
    {
      "id": "mean-value-theorem",
      "title": "均值定理",
      "category": "theorem",
      "definition": "若 f 在閉區間 [a,b] 連續、在開區間 (a,b) 可微，則至少存在一點 c，使瞬時變化率等於整段區間的平均變化率。",
      "latex": "\\exists c \\in (a,b):\\quad f'(c)=\\frac{f(b)-f(a)}{b-a}",
      "simpleExplanation": "一段旅程中的某個瞬間速度，一定等於整段旅程的平均速度。",
      "symbolDefinitions": [
        { "symbol": "c", "latex": "c \\in (a,b)", "description": "滿足結論的區間內點。" },
        { "symbol": "average", "latex": "\\frac{f(b)-f(a)}{b-a}", "description": "區間上的平均變化率。" }
      ]
    },
    {
      "id": "chain-rule",
      "title": "鏈鎖律",
      "category": "calculus",
      "definition": "複合函數的導數等於外層函數在內層輸出處的導數，乘上內層函數的導數。",
      "latex": "\\frac{d}{dx}f(g(x))=f'(g(x))g'(x)",
      "simpleExplanation": "變化一層一層傳遞，總影響是每一層影響相乘。",
      "symbolDefinitions": [
        { "symbol": "g(x)", "latex": "g(x)", "description": "先被計算的內層函數。" },
        { "symbol": "f", "latex": "f", "description": "接收 g(x) 的外層函數。" }
      ]
    },
    {
      "id": "partial-derivative",
      "title": "偏導數",
      "category": "multivariable",
      "definition": "多變數函數對某一變數的偏導數，是固定其他變數，只讓指定變數改變時的瞬時變化率。",
      "latex": "\\frac{\\partial f}{\\partial x_i}(\\mathbf{x})=\\lim_{h\\to0}\\frac{f(\\mathbf{x}+h\\mathbf{e}_i)-f(\\mathbf{x})}{h}",
      "simpleExplanation": "面對很多旋鈕時，先固定其他旋鈕，只轉動其中一個來看影響。",
      "symbolDefinitions": [
        { "symbol": "partial", "latex": "\\partial", "description": "表示多變數函數的偏微分。" },
        { "symbol": "e_i", "latex": "\\mathbf{e}_i", "description": "第 i 個座標方向的單位向量。" }
      ]
    },
    {
      "id": "gradient",
      "title": "梯度",
      "category": "multivariable",
      "definition": "梯度把所有一階偏導數排列成向量。它指向函數值上升最快的方向，長度代表該方向的最大上升率。",
      "latex": "\\nabla f(\\mathbf{x})=\\left(\\frac{\\partial f}{\\partial x_1},\\ldots,\\frac{\\partial f}{\\partial x_n}\\right)",
      "simpleExplanation": "站在山坡上，梯度就是最陡的上坡方向與坡度。",
      "symbolDefinitions": [
        { "symbol": "nabla", "latex": "\\nabla f", "description": "函數 f 的梯度向量。" },
        { "symbol": "x", "latex": "\\mathbf{x}", "description": "由多個座標組成的輸入向量。" }
      ]
    },
    {
      "id": "constrained-optimization",
      "title": "限制式最佳化",
      "category": "optimization",
      "definition": "限制式最佳化是在滿足等式或不等式限制的可行集合內，尋找目標函數最大值或最小值的問題。",
      "latex": "\\min_{\\mathbf{x}} f(\\mathbf{x})\\quad \\text{s.t.}\\quad g(\\mathbf{x})=0",
      "simpleExplanation": "不是任意找最低點，而是在規則允許的範圍內找最低點。",
      "symbolDefinitions": [
        { "symbol": "f", "latex": "f(\\mathbf{x})", "description": "希望最小化或最大化的目標函數。" },
        { "symbol": "g", "latex": "g(\\mathbf{x})=0", "description": "解必須滿足的限制條件。" }
      ]
    },
    {
      "id": "taylor-series",
      "title": "泰勒展開",
      "category": "analysis",
      "definition": "泰勒展開使用函數在單一點的各階導數，建立多項式來近似函數在該點附近的行為。",
      "latex": "f(x)=\\sum_{n=0}^{\\infty}\\frac{f^{(n)}(a)}{n!}(x-a)^n",
      "simpleExplanation": "只知道函數在一點附近的變化資訊，也能拼出一個局部近似模型。",
      "symbolDefinitions": [
        { "symbol": "f(n)", "latex": "f^{(n)}(a)", "description": "f 在 a 點的第 n 階導數。" },
        { "symbol": "n!", "latex": "n!", "description": "n 的階乘，用來調整各階項的尺度。" }
      ]
    },
    {
      "id": "newton-method",
      "title": "牛頓法",
      "category": "numerical",
      "definition": "牛頓法用目前位置的切線與 x 軸交點作為下一次近似，反覆迭代來求解非線性方程的根。",
      "latex": "x_{k+1}=x_k-\\frac{f(x_k)}{f'(x_k)}",
      "simpleExplanation": "從一個猜測開始，沿著切線快速修正，逐步靠近方程的解。",
      "symbolDefinitions": [
        { "symbol": "x_k", "latex": "x_k", "description": "第 k 次迭代的近似值。" },
        { "symbol": "f'(x_k)", "latex": "f'(x_k)", "description": "目前位置的切線斜率。" }
      ]
    }
  ],
